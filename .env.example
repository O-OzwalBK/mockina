# Copy this file to .env and fill in the values. Never commit .env.
# The API finds .env in the repo root, or in the folder you start it from.
# This project uses open-weight models only (Llama, Mistral, Qwen, DeepSeek, ...),
# either on your own machine or through a hosted inference provider.

# Required. Any OpenAI-compatible chat API. Include the /v1 part: the gateway adds
# /chat/completions to it.
#   Hosted provider:  https://api.example.com/v1
#   Ollama:           http://localhost:11434/v1
#   LM Studio:        http://localhost:1234/v1
LLM_BASE_URL=https://api.example.com/v1

# Required. The model's name exactly as the provider lists it.
LLM_MODEL=model-name-here

# Secret key from your provider.
# Leave it empty for local servers that need none (Ollama, LM Studio).
LLM_API_KEY=

# Optional. These are the defaults; set it in your .env file to configure
# Tokens the model can handle in one request, prompt and reply together.
# LLM_CONTEXT_TOKENS=8192
# Longest reply to ask for, in tokens.
# LLM_MAX_OUTPUT_TOKENS=1024
# Seconds to wait for the provider before giving up.
# LLM_TIMEOUT_SECONDS=60
# Extra attempts after a temporary failure (0 to 5).
# LLM_MAX_RETRIES=2

# Engine defaults, used when no user, preparation, or session sets an end rule.
# Questions in a fixed-count interview.
# ENGINE_DEFAULT_QUESTION_COUNT=5
# Total answering time, in seconds.
# ENGINE_DEFAULT_ANSWER_TIME_SECONDS=900
# Question range when the model decides; the minimum must be below the maximum.
# ENGINE_DEFAULT_MODEL_DECIDES_MIN=3
# ENGINE_DEFAULT_MODEL_DECIDES_MAX=12

# Where the SQLite session database lives. The default folder is git-ignored.
SESSION_STORE_PATH=data/session-store.sqlite3

# API settings. Use comma-separated browser origins, without trailing slashes.
API_CORS_ORIGINS=http://localhost:5173

# Developer model routes are useful for local testing. Set this to false in any
# deployed copy of the API.
API_DEV_ROUTES=true

# Days an anonymous user may stay inactive before their data is due for deletion.
# Shown to the browser by GET /v1/capabilities. The default is 30.
# Note: the automatic purge that enforces this is not built yet, so for now the value is
# only advertised; users are deleted by DELETE /v1/identity.
# API_ANON_RETENTION_DAYS=30
